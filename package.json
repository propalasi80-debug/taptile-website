{
  "name": "taptile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Taptile \u2014 programmable mini keyboards. Storefront.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && bash scripts/check-copy.sh && bash scripts/check-policies.sh && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:copy": "bash scripts/check-copy.sh",
    "check:policies": "bash scripts/check-policies.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.5"
  }
}
