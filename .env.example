# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase (accounts) -----------------------------------------------------
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Stripe (checkout) -------------------------------------------------------
# Checkout is a Stripe Payment Link. No API keys of any kind are needed.
# A secret (sk_) or restricted (rk_) key must NEVER appear here or anywhere in
# this repo: the build fails if one does. See docs/CHECKOUT.md.
#
# The Payment Link. Blank = the site stays a waitlist.
# Local dev: the TEST link (https://buy.stripe.com/test_...).
# On Vercel: set per environment — Preview = test link, Production = live link.
VITE_BUY_URL=

# Price shown on the site, in NZD. Must match the Payment Link's price.
# Defaults to 99.99 when blank. Change it together with VITE_BUY_URL.
VITE_PRICE_NZD=
